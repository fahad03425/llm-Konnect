@echo off
title LLM-Konnect Desktop Launcher
set "ROOT_DIR=%~dp0"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$root = '%ROOT_DIR%'.TrimEnd('\'); Write-Host '=======================================================' -ForegroundColor Cyan; Write-Host '         Starting LLM-KONNECT Desktop Application      ' -ForegroundColor Cyan; Write-Host '=======================================================' -ForegroundColor Cyan; try { $o = Test-NetConnection -ComputerName '127.0.0.1' -Port 11434 -WarningAction SilentlyContinue } catch {}; if (-not $o -or -not $o.TcpTestSucceeded) { Write-Host '[0/3] Starting Local Ollama AI Engine...' -ForegroundColor Yellow; $ollamaExe = \"$env:LOCALAPPDATA\Programs\Ollama\ollama.exe\"; if (Test-Path $ollamaExe) { Start-Process -FilePath $ollamaExe -ArgumentList 'serve' -WindowStyle Hidden; Start-Sleep -Seconds 2; } }; try { $r = Invoke-WebRequest -Uri 'http://127.0.0.1:8756/api/health' -TimeoutSec 2 -UseBasicParsing } catch {}; if (-not $r -or $r.StatusCode -ne 200) { Write-Host '[1/3] Starting Backend API Server on port 8756...' -ForegroundColor Yellow; Start-Process -FilePath 'python' -ArgumentList '-m', 'uvicorn', 'app.main:app', '--port', '8756', '--host', '127.0.0.1', '--reload' -WorkingDirectory \"$root\backend\" -WindowStyle Hidden; for ($i = 0; $i -lt 15; $i++) { Start-Sleep -Seconds 1; try { $chk = Invoke-WebRequest -Uri 'http://127.0.0.1:8756/api/health' -TimeoutSec 1 -UseBasicParsing; if ($chk -and $chk.StatusCode -eq 200) { break; } } catch {} } } else { Write-Host '[1/3] Backend is already running!' -ForegroundColor Green; }; try { $f = Invoke-WebRequest -Uri 'http://localhost:5173' -TimeoutSec 2 -UseBasicParsing } catch {}; if (-not $f -or $f.StatusCode -ne 200) { Write-Host '[2/3] Starting Desktop Frontend Server on port 5173...' -ForegroundColor Yellow; Start-Process -FilePath 'cmd.exe' -ArgumentList '/c', 'npm run dev' -WorkingDirectory \"$root\desktop\" -WindowStyle Hidden; for ($j = 0; $j -lt 15; $j++) { Start-Sleep -Seconds 1; try { $fchk = Invoke-WebRequest -Uri 'http://localhost:5173' -TimeoutSec 1 -UseBasicParsing; if ($fchk -and $fchk.StatusCode -eq 200) { break; } } catch {} } } else { Write-Host '[2/3] Desktop Frontend is already running!' -ForegroundColor Green; }; Write-Host '[3/3] Launching Dedicated Desktop Window...' -ForegroundColor Cyan; Start-Process 'msedge.exe' -ArgumentList '--app=http://localhost:5173/', '--window-size=1280,820'; Write-Host '=======================================================' -ForegroundColor Green; Write-Host 'Application successfully launched!' -ForegroundColor Green; Write-Host '=======================================================' -ForegroundColor Green;"

